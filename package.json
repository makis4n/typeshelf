{
  "name": "typeshelf",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:start": "pnpm dlx supabase start -x studio,imgproxy,storage-api,realtime,edge-runtime,logflare,vector,supavisor,postgres-meta",
    "db:stop": "pnpm dlx supabase stop"
  },
  "dependencies": {
    "@fontsource-variable/literata": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "solid-js": "^1.9.20"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "^5.1.1"
  }
}
