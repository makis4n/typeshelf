{
  "name": "typeshelf-books",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "kv_namespaces": [
    {
      "binding": "BOOKS",
      // PLACEHOLDER: replace with the id from `wrangler kv namespace create BOOKS`.
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173"
  }
}
